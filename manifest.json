    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "nav": { "label": "Shifts" },
  "icon": "📅",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_shifts", "shift_summary"]
  },
  "row_policies": {
    "shift_types": {
      "kind": "adult_writable"
    },
    "shifts": {
      "kind": "adult_writable"
    },
    "activity": {
      "kind": "owner_only",
      "member_column": "actor_id",
      "adults_bypass": false,
      "member_can_update": false
    }
  }
